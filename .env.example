# ========================================
# SUPABASE (obrigatório)
# ========================================
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# ========================================
# EMAIL - RESEND (recomendado)
# ========================================
EMAIL_PROVIDER=resend
EMAIL_FROM=contato@guiamarajoara.com
RESEND_API_KEY=re_sua_api_key_aqui

# ========================================
# EMAIL - SMTP/GMAIL (alternativa)
# ========================================
# EMAIL_PROVIDER=smtp
# EMAIL_FROM=seu-email@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu-email@gmail.com
# SMTP_PASS=sua-senha-de-app

# ========================================
# SITE
# ========================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ========================================
# GOOGLE MAPS & PLACES
# ========================================
# Chave pública para Maps JavaScript no navegador
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=sua-google-maps-api-key-aqui

# Chave privada para chamadas server-side (API Routes / Places Web Service)
GOOGLE_MAPS_SERVER_API_KEY=sua-google-maps-server-key-aqui

# ========================================
# ANALYTICS (GA4 + GTM)
# ========================================
# Opcional: Google Tag Manager (recomendado)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Opcional: Google Analytics 4 (usado como fallback sem GTM)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
